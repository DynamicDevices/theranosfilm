{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Separate editorial review of an exact contribution",
  "type":"object","additionalProperties":false,
  "required":["id","contribution_id","submission_sha256","reviewed_at","reviewer","decision","reasons","provenance","sources"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]+$"},
    "contribution_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]+$"},
    "submission_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "reviewed_at":{"type":"string","format":"date-time"},
    "reviewer":{"type":"object","additionalProperties":false,"required":["display_name","profile_url","kind"],"properties":{"display_name":{"type":"string","minLength":1},"profile_url":{"type":"string","format":"uri","pattern":"^https://github\\.com/[A-Za-z0-9-]+$"},"kind":{"enum":["human_recorded","automated"]}}},
    "decision":{"enum":["accepted","needs_evidence","disputed","rejected","superseded"]},
    "reasons":{"type":"string","minLength":1},
    "provenance":{"type":"object","additionalProperties":false,"required":["url","revision"],"properties":{"url":{"type":"string","pattern":"^https://github\\.com/DynamicDevices/theranosfilm/(pull|issues)/[0-9]+(#.*)?$"},"revision":{"type":"string","pattern":"^[a-f0-9]{40}$"}}},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["url","locator"],"properties":{"url":{"type":"string","format":"uri","pattern":"^https?://"},"locator":{"type":"string","minLength":1}}}}
  }
}
